# Development Environment Configuration
# Observability Stack Settings

# Environment
ENVIRONMENT=development
CLUSTER_NAME=bside-local-dev
APP_VERSION=1.0.0-dev

# OpenTelemetry
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_LOG_LEVEL=debug
TRACE_SAMPLING_PERCENTAGE=100

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=7d

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_SECRET_KEY=dev-secret-key-change-in-prod
GRAFANA_ROOT_URL=http://localhost:3000
GRAFANA_DOMAIN=localhost
GRAFANA_ANONYMOUS=true
GRAFANA_DB_TYPE=sqlite3
GRAFANA_LOG_LEVEL=debug

# Loki
LOKI_PORT=3100
LOKI_LOG_LEVEL=debug
LOKI_RETENTION_PERIOD=168h

# Promtail
PROMTAIL_LOG_LEVEL=debug

# Jaeger
JAEGER_STORAGE_TYPE=badger

# Redis
REDIS_ADDR=redis://redis:6379
REDIS_PASSWORD=

# Alert settings
SLACK_WEBHOOK_URL=
PAGERDUTY_KEY=
EMAIL_TO=
