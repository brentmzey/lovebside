@Composable
fun OrbitAnimation(profiles: List<love.bside.app.domain.models.Profile>) {
    val infiniteTransition = rememberInfiniteTransition()
    val pulseScale by infiniteTransition.animateFloat(
        initialValue = 1.0f,
        targetValue = 1.1f,
        animationSpec = infiniteRepeatable(
            animation = tween(2000, easing = LinearEasing),
            repeatMode = RepeatMode.Reverse
        )
    )
    
    // Layout Constants match visual proportions
    val outerRadius = 140.dp
    val innerRadius = 90.dp
    
    Box(contentAlignment = Alignment.Center) {
        // ... (Circles)
        
        // 4. Floating Elements on Outer Ring
        if (profiles.isNotEmpty()) {
            // Distribute profiles
            // We have 8 spots. 0, 45, 90, 135, 180, 225, 270, 315
            // Reserve 45 (Location) and 225 (Chat) for icons as per design
            // Spots: 0, 90, 135, 180, 270, 315 (6 spots for profiles)
            
            val profileSpots = listOf(0f, 90f, 135f, 180f, 270f, 315f)
            
            profileSpots.forEachIndexed { index, angle ->
                val profile = profiles.getOrNull(index % profiles.size)
                if (profile != null) {
                    OrbitItem(angle = angle, radius = outerRadius, content = { 
                       // Generate pastel color based on name hash
                       val color = generatePastelColor(profile.firstName)
                       AvatarPlaceholder(color = color, initial = profile.firstName.firstOrNull()?.toString() ?: "?")
                    })
                }
            }
        } else {
            // Fallback to static if no profiles (e.g. loading or network error)
            OrbitItem(angle = 0f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFF81C784)) })
            OrbitItem(angle = 90f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFFE57373)) })
            OrbitItem(angle = 135f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFFFFD54F)) })
            OrbitItem(angle = 180f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFF7986CB)) })
            OrbitItem(angle = 270f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFFBA68C8)) })
            OrbitItem(angle = 315f, radius = outerRadius, content = { AvatarPlaceholder(Color(0xFFFF8A65), size = 64.dp) })
        }
        
        // Icons (Fixed)
        OrbitItem(angle = 45f, radius = outerRadius, content = { 
             Icon(Icons.Default.LocationOn, null, tint = Color(0xFFF48FB1), modifier = Modifier.size(24.dp)) 
        })
        
        OrbitItem(angle = 225f, radius = outerRadius, content = { 
             Icon(Icons.Default.Message, null, tint = Color(0xFFF06292), modifier = Modifier.size(24.dp))
        })
    }
}

