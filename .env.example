# Environment Configuration

# PocketBase
PB_PUBLIC_URL=http://localhost:8090
POCKETBASE_ADMIN_EMAIL=tester_admin@bside.love
POCKETBASE_ADMIN_PASSWORD=password123

# CDN Configuration (AWS CloudFront + S3)
CDN_ENABLED=false
CDN_BASE_URL=

# AWS S3 (for CDN uploads)
AWS_REGION=us-east-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# File Upload Limits
MAX_FILE_SIZE=52428800  # 50MB in bytes
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,image/webp,video/mp4,video/quicktime

# Production values (uncomment and fill when deploying):
# PB_PUBLIC_URL=https://api.bside.app
# CDN_ENABLED=true
# CDN_BASE_URL=https://cdn.bside.app
# AWS_S3_BUCKET=bside-media-prod
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
