{
  "name": "bside-readme-docs",
  "version": "1.0.0",
  "description": "B-Side documentation for ReadMe.com",
  "scripts": {
    "validate": "node publish-to-readme.js --validate",
    "generate": "node publish-to-readme.js --generate",
    "upload": "node publish-to-readme.js --upload",
