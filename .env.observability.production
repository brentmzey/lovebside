# Production Environment Configuration
# Observability Stack Settings

# Environment
ENVIRONMENT=production
CLUSTER_NAME=bside-prod
APP_VERSION=1.0.0

# OpenTelemetry
OTEL_GRPC_PORT=4317
OTEL_HTTP_PORT=4318
OTEL_LOG_LEVEL=info
TRACE_SAMPLING_PERCENTAGE=10

# Prometheus
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=90d

# Grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=${GRAFANA_ADMIN_PASSWORD}
GRAFANA_SECRET_KEY=${GRAFANA_SECRET_KEY}
GRAFANA_ROOT_URL=https://grafana.bside.love
GRAFANA_DOMAIN=grafana.bside.love
GRAFANA_ANONYMOUS=false
GRAFANA_DB_TYPE=postgres
GRAFANA_LOG_LEVEL=info

# Loki
LOKI_PORT=3100
LOKI_LOG_LEVEL=info
LOKI_RETENTION_PERIOD=720h

# Promtail
PROMTAIL_LOG_LEVEL=info

# Jaeger
JAEGER_STORAGE_TYPE=elasticsearch

# Redis
REDIS_ADDR=redis://redis:6379
REDIS_PASSWORD=${REDIS_PASSWORD}

# Alert settings
SLACK_WEBHOOK_URL=${SLACK_WEBHOOK_URL}
PAGERDUTY_KEY=${PAGERDUTY_KEY}
EMAIL_TO=${ALERT_EMAIL}
