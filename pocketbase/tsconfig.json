{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "lib": [
            "ES2016",
            "DOM"
        ],
        "strict": true,
        "noImplicitAny": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "outDir": "./pb_hooks"
    },
    "ts-node": {
        "esm": true
    },
    "include": [
        "src/**/*"
    ]
}