# Add scripts directory to PATH for easy access to development scripts
PATH_add scripts

# Ensure .pids directory exists for background process management
mkdir -p .pids

# Set project root for reference
export BSIDE_PROJECT_ROOT="$(pwd)"

# Helpful aliases (if direnv supports them in your shell)
# Otherwise, these can be added to your .bashrc/.zshrc
echo "✨ B-Side development scripts loaded!"
echo "   Platform runners: run-android, run-desktop, run-ios, run-web, run-server"
echo "   Utilities: start-all, stop-all, build-all, verify-targets"
echo "   Testing: test-full-stack, test-server-db"
echo ""
echo "   All scripts are executable and in PATH. Type 'run-' and press TAB for autocomplete."

