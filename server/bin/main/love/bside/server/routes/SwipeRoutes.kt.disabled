package love.bside.server.routes

import io.ktor.http.*
import io.ktor.server.application.*
import io.ktor.server.request.*
import io.ktor.server.response.*
import io.ktor.server.routing.*
import kotlinx.serialization.Serializable
import love.bside.server.services.DistributedLock
import love.bside.server.services.IdempotentResult
import love.bside.server.repositories.SwipeRepository
import love.bside.server.repositories.MatchRepository
import love.bside.app.core.Result

/**
 * Swipe Routes
 * 
 * Implements race-condition-free swiping with:
 * - Idempotency tokens (prevent double-swipes)
 * - Pessimistic locking (prevent duplicate matches)
 * - Transaction coordination (atomic match creation)
 * 
 * @see .code-hq/CONSISTENCY_STRATEGY.md
 */

@Serializable
data class SwipeRequest(
    val userId: String,
    val targetId: String,
    val action: String,  // "like" | "pass" | "superlike"
    val idempotencyToken: String? = null
)

@Serializable
data class SwipeResponse(
    val success: Boolean,
    val swipeId: String? = null,
    val match: MatchResponse? = null,
    val cached: Boolean = false
)

@Serializable
data class MatchResponse(
    val matchId: String,
    val userId: String,
    val targetId: String,
    val createdAt: String
)

fun Route.swipeRoutes(
    swipeRepository: SwipeRepository,
    matchRepository: MatchRepository
) {
    route("/api/v1") {
        
        /**
         * POST /api/v1/swipe
         * 
         * Record a swipe action (like/pass/superlike)
         * 
         * Features:
         * - Idempotency: Same token = same result
         * - Locking: Prevents double-swipe race condition
         * - Matching: Auto-creates match if mutual like
         */
        post("/swipe") {
            // Extract idempotency token from header or body
            val token = call.request.header("X-Idempotency-Token")
                ?: call.receive<SwipeRequest>().idempotencyToken
            
            if (token == null) {
                call.respond(
                    HttpStatusCode.BadRequest,
                    mapOf("error" to "Idempotency token required")
                )
                return@post
            }
            
            val request = call.receive<SwipeRequest>()
            
            // Validate action
            if (request.action !in listOf("like", "pass", "superlike")) {
                call.respond(
                    HttpStatusCode.BadRequest,
                    mapOf("error" to "Invalid action: ${request.action}")
                )
                return@post
            }
            
            // Validate IDs
            if (request.userId == request.targetId) {
                call.respond(
                    HttpStatusCode.BadRequest,
                    mapOf("error" to "Cannot swipe on yourself")
                )
                return@post
            }
            
            // Execute with idempotency
            val result = DistributedLock.executeIdempotent(token) {
                processSwipe(request, swipeRepository, matchRepository)
            }
            
            when (result) {
                is IdempotentResult.Fresh -> {
                    call.respond(HttpStatusCode.Created, result.value)
                }
                is IdempotentResult.Cached -> {
                    // Return cached result
                    call.respond(HttpStatusCode.OK, result.cachedResponse)
                }
            }
        }
        
        /**
         * GET /api/v1/swipes/:userId
         * 
         * Get user's swipe history
         */
        get("/swipes/{userId}") {
            val userId = call.parameters["userId"]
            if (userId == null) {
                call.respond(
                    HttpStatusCode.BadRequest,
                    mapOf("error" to "User ID required")
                )
                return@get
            }
            
            when (val result = swipeRepository.getSwipesByUser(userId)) {
                is Result.Success -> call.respond(HttpStatusCode.OK, result.data)
                is Result.Error -> call.respond(
                    HttpStatusCode.InternalServerError,
                    mapOf("error" to result.exception.message)
                )
                is Result.Loading -> call.respond(
                    HttpStatusCode.InternalServerError,
                    mapOf("error" to "Unexpected loading state")
                )
            }
        }
        
        /**
         * GET /api/v1/matches/:userId
         * 
         * Get user's matches
         */
        get("/matches/{userId}") {
            val userId = call.parameters["userId"]
            if (userId == null) {
                call.respond(
                    HttpStatusCode.BadRequest,
                    mapOf("error" to "User ID required")
                )
                return@get
            }
            
            when (val result = matchRepository.getMatchesForUser(userId)) {
                is Result.Success -> call.respond(HttpStatusCode.OK, result.data)
                is Result.Error -> call.respond(
                    HttpStatusCode.InternalServerError,
                    mapOf("error" to result.exception.message)
                )
                is Result.Loading -> call.respond(
                    HttpStatusCode.InternalServerError,
                    mapOf("error" to "Unexpected loading state")
                )
            }
        }
    }
}

/**
 * Process swipe with pessimistic locking
 * 
 * Steps:
 * 1. Acquire lock (prevent race condition)
 * 2. Check if already swiped
 * 3. Check for mutual match
 * 4. Create swipe record
 * 5. Create match if mutual like
 */
private suspend fun processSwipe(
    request: SwipeRequest,
    swipeRepository: SwipeRepository,
    matchRepository: MatchRepository
): SwipeResponse {
    // Acquire exclusive lock for this swipe pair
    return DistributedLock.withLock(
        lockKey = "swipe:${request.userId}:${request.targetId}"
    ) {
        // 1. Check if already swiped
        val existingResult = swipeRepository.getSwipe(request.userId, request.targetId)
        if (existingResult is Result.Success && existingResult.data != null) {
            val existingSwipe = existingResult.data!!
            // Already swiped! Return existing result
            val existingMatch = if (existingSwipe.action == "like") {
                when (val matchResult = matchRepository.getMatchById(existingSwipe.id)) {
                    is Result.Success -> matchResult.data
                    is Result.Error -> null
                    is Result.Loading -> null
                }
            } else null
            
            return@withLock SwipeResponse(
                success = true,
                swipeId = existingSwipe.id,
                match = existingMatch?.let {
                    MatchResponse(
                        matchId = it.id,
                        userId = it.user1Id ?: "",
                        targetId = it.user2Id ?: "",
                        createdAt = it.createdAt ?: ""
                    )
                },
                cached = true
            )
        }
        
        // 2. Create swipe record
        val swipeResult = swipeRepository.createSwipe(
            userId = request.userId,
            targetId = request.targetId,
            action = request.action
        )
        
        val swipe = when (swipeResult) {
            is Result.Success -> swipeResult.data
            is Result.Error -> throw swipeResult.exception
            is Result.Loading -> throw Exception("Unexpected loading state")
        }
        
        // Track write for read-after-write consistency
        DistributedLock.trackWrite("swipes", swipe.id)
        
        // 3. Check if mutual match (they liked us)
        val theirSwipeResult = swipeRepository.getSwipe(request.targetId, request.userId)
        val theirSwipe = when (theirSwipeResult) {
            is Result.Success -> theirSwipeResult.data
            is Result.Error -> null
            is Result.Loading -> null
        }
        
        val match = if (request.action == "like" && theirSwipe?.action == "like") {
            // It's a match! Create match record
            createMatch(
                userId = request.userId,
                targetId = request.targetId,
                matchRepository = matchRepository
            )
        } else null
        
        SwipeResponse(
            success = true,
            swipeId = swipe.id,
            match = match,
            cached = false
        )
    }
}

/**
 * Create match with transaction-like semantics
 * 
 * This should eventually use a proper transaction coordinator
 * for multi-entity updates
 */
private suspend fun createMatch(
    userId: String,
    targetId: String,
    matchRepository: MatchRepository
): MatchResponse? {
    // Create match with compatibility score (calculate later)
    val matchResult = matchRepository.createMatch(userId, targetId, 0.0)
    
    val match = when (matchResult) {
        is Result.Success -> matchResult.data
        is Result.Error -> return null
        is Result.Loading -> return null
    }
    
    // Track write
    DistributedLock.trackWrite("matches", match.id)
    
    // TODO: Send notifications to both users
    // TODO: Update analytics counters
    // TODO: Create conversation for the match
    
    return MatchResponse(
        matchId = match.id,
        userId = match.user1Id ?: "",
        targetId = match.user2Id ?: "",
        createdAt = match.createdAt ?: ""
    )
}
