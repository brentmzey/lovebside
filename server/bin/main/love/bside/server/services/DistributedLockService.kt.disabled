package love.bside.server.services

import io.lettuce.core.RedisClient
import io.lettuce.core.SetArgs
import io.lettuce.core.api.StatefulRedisConnection
import io.lettuce.core.api.sync.RedisCommands
import kotlinx.coroutines.delay
import java.util.UUID
import java.util.concurrent.ConcurrentHashMap
import kotlin.math.pow

/**
 * Distributed Locking Service
 * 
 * Prevents race conditions across multiple server instances
 * 
 * Features:
 * - Optimistic locking (version checking)
 * - Pessimistic locking (Redis-based)
 * - Idempotency tokens
 * - Message sequencing
 * - Read-after-write tracking
 * 
 * @see .code-hq/CONSISTENCY_STRATEGY.md
 */
class DistributedLockService(redisUrl: String) {
    private val client: RedisClient = RedisClient.create(redisUrl)
    private val connection: StatefulRedisConnection<String, String> = client.connect()
    private val redis: RedisCommands<String, String> = connection.sync()
    
    private val writeTimes = ConcurrentHashMap<String, Long>()
    
    // ==========================================
    // PESSIMISTIC LOCKING (Redis-Based)
    // ==========================================
    
    /**
     * Acquire exclusive lock before operation
     * 
     * Use for: Critical operations
     * - Swipe actions (prevent double-swipe)
     * - Match creation (prevent duplicates)
     * - Payment processing
     */
    suspend fun <T> withLock(
        lockKey: String,
        operation: suspend () -> T,
        ttlMs: Long = 5000,
        maxRetries: Int = 10,
        retryDelayMs: Long = 50
    ): T {
        val lockValue = UUID.randomUUID().toString()
        val lockPath = "lock:$lockKey"
        var retries = 0
        
        while (retries < maxRetries) {
            // Try to acquire lock
            val acquired = redis.set(
                lockPath,
                lockValue,
                SetArgs().px(ttlMs).nx()
            )
            
            if (acquired == "OK") {
                try {
                    // Lock acquired! Execute operation
                    return operation()
                } finally {
                    // Release lock (only if we still own it)
                    releaseLock(lockPath, lockValue)
                }
            }
            
            // Lock not acquired, wait and retry
            retries++
            val delayTime = (retryDelayMs * 1.5.pow(retries)).toLong()
            val jitter = (Math.random() * delayTime).toLong()
            delay(delayTime + jitter)
        }
        
        throw LockAcquisitionException("Failed to acquire lock: $lockKey after $maxRetries attempts")
    }
    
    private fun releaseLock(lockPath: String, lockValue: String) {
        // Lua script: Only delete if value matches (atomic)
        val script = """
            if redis.call("get", KEYS[1]) == ARGV[1] then
                return redis.call("del", KEYS[1])
            else
                return 0
            end
        """.trimIndent()
        
        redis.eval<Long>(script, arrayOf(lockPath), lockValue)
    }
    
    // ==========================================
    // IDEMPOTENCY (Token-Based)
    // ==========================================
    
    /**
     * Execute operation only once per token
     * 
     * Use for: User-facing actions
     * - Button double-clicks
     * - Network retries
     * - Mobile app reconnections
     */
    suspend fun <T> executeIdempotent(
        token: String,
        operation: suspend () -> T,
        ttlSeconds: Long = 86400  // Cache result for 24h
    ): IdempotentResult<T> {
        val key = "idempotency:$token"
        
        // Check if already processed
        val cached = redis.get(key)
        if (cached != null) {
            println("♻️  Idempotency hit: $token")
            return IdempotentResult.Cached(cached)
        }
        
        // Mark as in-progress
        val acquired = redis.set(
            key,
            """{"status":"PROCESSING"}""",
            SetArgs().ex(ttlSeconds).nx()
        )
        
        if (acquired != "OK") {
            // Another request with same token is in progress
            delay(100)
            return executeIdempotent(token, operation, ttlSeconds)
        }
        
        try {
            // Execute operation
            val result = operation()
            
            // Cache result
            redis.setex(
                key,
                ttlSeconds,
                """{"status":"SUCCESS","result":"$result"}"""
            )
            
            println("✅ Idempotency: Executed $token")
            return IdempotentResult.Fresh(result)
            
        } catch (e: Exception) {
            // Operation failed, allow retry
            redis.del(key)
            throw e
        }
    }
    
    // ==========================================
    // READ-AFTER-WRITE CONSISTENCY
    // ==========================================
    
    /**
     * Track write for read-after-write consistency
     */
    fun trackWrite(collection: String, id: String) {
        writeTimes["$collection:$id"] = System.currentTimeMillis()
    }
    
    /**
     * Check if entity was recently written
     */
    fun wasRecentlyWritten(
        collection: String,
        id: String,
        windowMs: Long = 2000
    ): Boolean {
        val writeTime = writeTimes["$collection:$id"] ?: return false
        return (System.currentTimeMillis() - writeTime) < windowMs
    }
    
    /**
     * Clean up old write timestamps
     */
    fun cleanupWriteTimes(maxAgeMs: Long = 60000) {
        val now = System.currentTimeMillis()
        writeTimes.entries.removeIf { (_, time) ->
            now - time > maxAgeMs
        }
    }
    
    // ==========================================
    // MESSAGE SEQUENCING
    // ==========================================
    
    /**
     * Get next sequence number for conversation
     */
    suspend fun getNextSequence(conversationId: String): Long {
        return withLock(
            "conversation:$conversationId:seq",
            {
                val current = redis.get("seq:$conversationId")?.toLongOrNull() ?: 0
                val next = current + 1
                redis.set("seq:$conversationId", next.toString())
                next
            }
        )
    }
    
    /**
     * Store message with sequence number
     */
    suspend fun storeSequencedMessage(
        conversationId: String,
        messageJson: String
    ): Long {
        val sequenceNumber = getNextSequence(conversationId)
        
        // Store message with sequence (using sorted set)
        redis.zadd(
            "messages:$conversationId",
            sequenceNumber.toDouble(),
            messageJson
        )
        
        return sequenceNumber
    }
    
    /**
     * Get messages in order
     */
    fun getSequencedMessages(
        conversationId: String,
        fromSeq: Long,
        toSeq: Long
    ): List<String> {
        return redis.zrangebyscore(
            "messages:$conversationId",
            fromSeq.toDouble(),
            toSeq.toDouble()
        )
    }
    
    // ==========================================
    // HEALTH CHECK
    // ==========================================
    
    fun healthCheck(): Boolean {
        return try {
            redis.ping() == "PONG"
        } catch (e: Exception) {
            false
        }
    }
    
    fun getMetrics(): Map<String, String> {
        val info = redis.info("stats")
        val metrics = mutableMapOf<String, String>()
        
        info.lines().forEach { line ->
            val parts = line.split(":")
            if (parts.size == 2) {
                metrics[parts[0]] = parts[1]
            }
        }
        
        return mapOf(
            "totalConnections" to (metrics["total_connections_received"] ?: "0"),
            "totalCommands" to (metrics["total_commands_processed"] ?: "0"),
            "usedMemory" to (metrics["used_memory_human"] ?: "0"),
            "connectedClients" to (metrics["connected_clients"] ?: "0"),
            "blockedClients" to (metrics["blocked_clients"] ?: "0")
        )
    }
    
    fun close() {
        connection.close()
        client.shutdown()
    }
}

// ==========================================
// DATA CLASSES
// ==========================================

sealed class IdempotentResult<T> {
    data class Fresh<T>(val value: T) : IdempotentResult<T>()
    data class Cached<T>(val cachedResponse: String) : IdempotentResult<T>()
}

class LockAcquisitionException(message: String) : Exception(message)

// ==========================================
// SINGLETON INSTANCE
// ==========================================

object DistributedLock {
    private val service by lazy {
        val redisUrl = System.getenv("REDIS_URL") ?: "redis://localhost:6379"
        DistributedLockService(redisUrl)
    }
    
    suspend fun <T> withLock(
        lockKey: String,
        operation: suspend () -> T
    ): T = service.withLock(lockKey, operation)
    
    suspend fun <T> executeIdempotent(
        token: String,
        operation: suspend () -> T
    ): IdempotentResult<T> = service.executeIdempotent(token, operation)
    
    fun trackWrite(collection: String, id: String) =
        service.trackWrite(collection, id)
    
    fun wasRecentlyWritten(collection: String, id: String) =
        service.wasRecentlyWritten(collection, id)
    
    suspend fun getNextSequence(conversationId: String) =
        service.getNextSequence(conversationId)
    
    fun healthCheck() = service.healthCheck()
    fun getMetrics() = service.getMetrics()
    
    // Cleanup task (call from scheduler)
    fun cleanup() = service.cleanupWriteTimes()
}
