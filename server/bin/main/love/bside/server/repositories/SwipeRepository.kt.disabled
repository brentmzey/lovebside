package love.bside.server.repositories

import love.bside.app.data.api.PocketBaseClient
import love.bside.app.core.Result
import love.bside.app.core.AppException
import kotlinx.serialization.Serializable
import kotlinx.serialization.json.*
import com.google.gson.JsonArray
import com.google.gson.JsonObject

/**
 * Swipe Repository
 * 
 * Manages swipe records in PocketBase
 * 
 * Collection: sw_swipes
 * Fields:
 * - id: String (auto)
 * - user_id: String (relation to t_user)
 * - target_id: String (relation to t_user)
 * - action: String ("like" | "pass" | "superlike")
 * - version: Int (for optimistic locking)
 * - created: String (auto)
 * - updated: String (auto)
 */

@Serializable
data class Swipe(
    val id: String,
    val user_id: String,
    val target_id: String,
    val action: String,
    val version: Int = 1,
    val created: String,
    val updated: String
)

@Serializable
data class PBSwipe(
    val id: String? = null,
    val user_id: String,
    val target_id: String,
    val action: String,
    val version: Int = 1,
    val created: String? = null,
    val updated: String? = null
)

interface SwipeRepository {
    suspend fun getSwipe(userId: String, targetId: String): Result<Swipe?>
    suspend fun getSwipesByUser(userId: String): Result<List<Swipe>>
    suspend fun getSwipesForUser(targetId: String): Result<List<Swipe>>
    suspend fun createSwipe(userId: String, targetId: String, action: String): Result<Swipe>
}

class SwipeRepositoryImpl(
    private val pocketBase: PocketBaseClient
) : SwipeRepository {
    
    private val collection = "sw_swipes"
    
    /**
     * Get swipe between two users
     */
    override suspend fun getSwipe(userId: String, targetId: String): Result<Swipe?> {
        return try {
            val filter = "user_id='$userId' && target_id='$targetId'"
            val response = pocketBase.getList(collection, 1, 1, filter)
            
            when (response) {
                is Result.Success -> {
                    val items = response.data.jsonObject["items"]?.jsonArray
                    if (items.isNullOrEmpty()) {
                        Result.Success(null)
                    } else {
                        val swipeJson = items.first()
                        val swipe = Json.decodeFromJsonElement<Swipe>(swipeJson)
                        Result.Success(swipe)
                    }
                }
                is Result.Error -> Result.Success(null)  // Not found is OK
            }
        } catch (e: Exception) {
            Result.Error(e)
        }
    }
    
    /**
     * Get all swipes made by user
     */
    override suspend fun getSwipesByUser(userId: String): Result<List<Swipe>> {
        return try {
            val filter = "user_id='$userId'"
            val response = pocketBase.getList(collection, 1, 50, filter, "-created")
            
            when (response) {
                is Result.Success -> {
                    val items = response.data.jsonObject["items"]?.jsonArray ?: jsonArrayOf()
                    val swipes = items.map { Json.decodeFromJsonElement<Swipe>(it) }
                    Result.Success(swipes)
                }
                is Result.Error -> Result.Error(response.exception)
            }
        } catch (e: Exception) {
            Result.Error(e)
        }
    }
    
    /**
     * Get all swipes received by user (who swiped on them)
     */
    override suspend fun getSwipesForUser(targetId: String): Result<List<Swipe>> {
        return try {
            val filter = "target_id='$targetId'"
            val response = pocketBase.getList(collection, 1, 50, filter, "-created")
            
            when (response) {
                is Result.Success -> {
                    val items = response.data.getAsJsonObject()["items"]?.asJsonArray ?: JsonArray()
                    val swipes = items.map { Json.decodeFromJsonElement<Swipe>(it) }
                    Result.Success(swipes)
                }
                is Result.Error -> Result.Error(response.exception)
                is Result.Loading -> Result.Error(Exception("Unexpected loading state"))
            }
        } catch (e: Exception) {
            Result.Error(AppException.DatabaseException("Failed to get swipes for user", e))
        }
    }
    
    /**
     * Create swipe record
     * Note: Caller must handle duplicate detection via getSwipe first
     */
    override suspend fun createSwipe(
        userId: String,
        targetId: String,
        action: String
    ): Result<Swipe> {
        return try {
            val data = buildJsonObject {
                put("user_id", userId)
                put("target_id", targetId)
                put("action", action)
                put("version", 1)
            }
            
            val response = pocketBase.create(collection, data)
            
            when (response) {
                is Result.Success -> {
                    val swipe = Json.decodeFromJsonElement<Swipe>(response.data)
                    Result.Success(swipe)
                }
                is Result.Error -> Result.Error(response.exception)
                is Result.Loading -> Result.Error(Exception("Unexpected loading state"))
            }
        } catch (e: Exception) {
            Result.Error(AppException.DatabaseException("Failed to create swipe", e))
        }
    }
}
